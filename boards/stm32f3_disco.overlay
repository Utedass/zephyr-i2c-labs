/ {
    aliases {
        my-led = &red_led_3;
    };
    chosen {
        zephyr,console = &usart1;
        zephyr,shell-uart = &usart1;
    };
    zephyr,user {
        /* adjust channel number according to pinmux in board.dts */
        io-channels = <&adc1 1>;
    };
};

&usart1 {
    current-speed = <1000000>;
    fifo-enable;
};

&i2c1 {
    cg1: si5351@60 {
        compatible = "skyworks,si5351";
        reg = <0x60>;
        #address-cells = <1>;
        #size-cells = <0>;

        clkout0: clock@0 {
            compatible = "skyworks,si5351-output";
            reg = <0>;
            #clock-cells = <0>;
        };

        clkout1: clock@1 {
            compatible = "skyworks,si5351-output";
            reg = <1>;
            #clock-cells = <0>;
        };
    };
    cg2: si5351@61 {
        compatible = "skyworks,si5351";
        reg = <0x61>;
        #address-cells = <1>;
        #size-cells = <0>;

        clkout3: clock@0 {
            compatible = "skyworks,si5351-output";
            reg = <0>;
            #clock-cells = <0>;
        };

        clkout4: clock@1 {
            compatible = "skyworks,si5351-output";
            reg = <1>;
            #clock-cells = <0>;
        };
    };
};

